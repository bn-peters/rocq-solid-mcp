{
  "timeout_policy": {
    "request_seconds": 4,
    "cancel_grace_seconds": 0
  },
  "steps": [
    {
      "label": "check through hard timeout",
      "action": "check",
      "file": "src/hard_timeout.v",
      "min_seconds": 3,
      "long_running_seconds": 0
    },
    {
      "label": "remove later slow tactic",
      "action": "replace",
      "file": "src/hard_timeout.v",
      "old": "sleep 7",
      "new": "sleep 0"
    },
    {
      "label": "fix later proof",
      "action": "replace",
      "file": "src/hard_timeout.v",
      "old": "fail.",
      "new": "easy."
    },
    {
      "label": "recheck after hard timeout",
      "action": "check",
      "file": "src/hard_timeout.v",
      "min_seconds": 1,
      "long_running_seconds": 0
    }
  ]
}
