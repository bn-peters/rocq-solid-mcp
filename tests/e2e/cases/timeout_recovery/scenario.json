{
  "timeout_policy": {
    "request_seconds": 1,
    "cancel_grace_seconds": 1
  },
  "steps": [
    {
      "label": "compile slow proof with short timeout",
      "action": "compile",
      "file": "src/timeout.v",
      "max_seconds": 4,
      "long_running_seconds": 0
    },
    {
      "label": "remove slow tactic",
      "action": "replace",
      "file": "src/timeout.v",
      "old": "sleep 5",
      "new": "sleep 0"
    },
    {
      "label": "recompile after timeout",
      "action": "compile",
      "file": "src/timeout.v",
      "max_seconds": 4,
      "long_running_seconds": 0
    }
  ]
}
