{
  "timeout_policy": {
    "request_seconds": 10,
    "cancel_grace_seconds": 1
  },
  "steps": [
    {
      "label": "check slow command with per-call sentence timeout",
      "action": "check",
      "file": "src/timeout.v",
      "command_timeout_seconds": 1,
      "max_seconds": 4,
      "long_running_seconds": 0
    },
    {
      "label": "remove slow command",
      "action": "replace",
      "file": "src/timeout.v",
      "old": "sleep 5",
      "new": "sleep 0"
    },
    {
      "label": "recheck without per-call timeout",
      "action": "check",
      "file": "src/timeout.v",
      "max_seconds": 4,
      "long_running_seconds": 0
    }
  ]
}
