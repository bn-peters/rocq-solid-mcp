{
  "timeout_policy": {
    "request_seconds": 60,
    "cancel_grace_seconds": 2,
    "command_seconds": 10,
    "command_seconds_after_error": 2
  },
  "steps": [
    {
      "label": "check reports both errors then cancels the slow proof quickly",
      "action": "check",
      "file": "src/after_error.v",
      "min_seconds": 5,
      "max_seconds": 20,
      "long_running_seconds": 0
    },
    {
      "label": "cached recheck reports the same errors quickly",
      "action": "check",
      "file": "src/after_error.v",
      "max_seconds": 12,
      "long_running_seconds": 0
    },
    {
      "label": "fix the first error",
      "action": "replace",
      "file": "src/after_error.v",
      "old": "fail \"FIRST\"",
      "new": "exact I"
    },
    {
      "label": "fix the second error",
      "action": "replace",
      "file": "src/after_error.v",
      "old": "fail \"SECOND\"",
      "new": "exact I"
    },
    {
      "label": "remove the slow tactic",
      "action": "replace",
      "file": "src/after_error.v",
      "old": "sleep 30",
      "new": "sleep 0"
    },
    {
      "label": "clean recheck completes",
      "action": "check",
      "file": "src/after_error.v",
      "max_seconds": 10,
      "long_running_seconds": 0
    }
  ]
}
