{
  "steps": [
    {
      "label": "check file with slow preceding proof",
      "action": "check",
      "file": "src/cache.v",
      "min_seconds": 3,
      "long_running_seconds": 3
    },
    {
      "label": "fix proof after slow proof",
      "action": "replace",
      "file": "src/cache.v",
      "old": "fail.",
      "new": "easy."
    },
    {
      "label": "recheck fixed proof from cache",
      "action": "check",
      "file": "src/cache.v",
      "max_seconds": 4,
      "long_running_seconds": 3
    }
  ]
}
