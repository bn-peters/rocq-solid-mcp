{
  "timeout_policy": {
    "request_seconds": 5,
    "cancel_grace_seconds": 2
  },
  "steps": [
    {
      "label": "check through cached error into first timeout",
      "action": "check",
      "file": "src/resume_timeout.v",
      "min_seconds": 4,
      "max_seconds": 9,
      "long_running_seconds": 0
    },
    {
      "label": "check resumes and times out later",
      "action": "check",
      "file": "src/resume_timeout.v",
      "min_seconds": 4,
      "max_seconds": 9,
      "long_running_seconds": 0
    },
    {
      "label": "check completes from cached timeout progress",
      "action": "check",
      "file": "src/resume_timeout.v",
      "max_seconds": 6,
      "long_running_seconds": 0
    }
  ]
}
