{
  "timeout_policy": {
    "request_seconds": 60,
    "cancel_grace_seconds": 2,
    "command_seconds": 30,
    "request_seconds_after_error": 6
  },
  "steps": [
    {
      "label": "check stops at most the after-error deadline after the first error",
      "action": "check",
      "file": "src/after_error.v",
      "min_seconds": 6,
      "max_seconds": 18,
      "long_running_seconds": 0
    },
    {
      "label": "fix the first error",
      "action": "replace",
      "file": "src/after_error.v",
      "old": "fail \"FIRST\"",
      "new": "exact I"
    },
    {
      "label": "fix the second error",
      "action": "replace",
      "file": "src/after_error.v",
      "old": "fail \"SECOND\"",
      "new": "exact I"
    },
    {
      "label": "shrink the slow chain",
      "action": "replace",
      "file": "src/after_error.v",
      "old": "  sleep 10.\n  sleep 10.",
      "new": "  sleep 7."
    },
    {
      "label": "without an error the deadline never arms",
      "action": "check",
      "file": "src/after_error.v",
      "min_seconds": 7,
      "max_seconds": 18,
      "long_running_seconds": 0
    }
  ]
}
